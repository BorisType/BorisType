{
  "name": "@boristype/ws-client",
  "version": "0.1.0-alpha.9",
  "description": "WSHCM SOAP client — клиент для работы с WebSoft HCM через SP-XML API",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "resources",
    "README.md"
  ],
  "scripts": {
    "build": "node tools/prepare-runtime.mjs && tsc",
    "build:runtime": "node tools/prepare-runtime.mjs",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "pnpm build",
    "prepack": "pnpm build",
    "test:e2e:values": "node --test --test-concurrency=1 test/e2e/values.mjs",
    "test:e2e:xquery": "node --test --test-concurrency=1 test/e2e/xquery.mjs",
    "test:e2e:packages": "node test/e2e/packages.mjs",
    "test:e2e:object-patch": "node test/e2e/object-patch.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "saxes": "^6.0.0",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/yauzl": "3.4.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "wshcm",
    "soap",
    "websoft",
    "hcm"
  ],
  "author": "BorisType Project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BorisType/BorisType.git"
  },
  "bugs": {
    "url": "https://github.com/BorisType/BorisType/issues"
  },
  "homepage": "https://github.com/BorisType/BorisType#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
