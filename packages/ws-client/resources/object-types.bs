function BtCatalogObjectName(form) {
    try {
        return form.ObjectName;
    } catch (error) {
        if (!StrContains(String(error), 'Unknown object property: ObjectName')) throw error;
        return undefined;
    }
}

// Enumerate metadata provided by HCM. Document names and catalog names are independent.
function BtListObjectTypes(_btTypesReq) {
    var _btTypesMaxSource = 4096;
    var _btTypesItems = [];
    var _btTypesPage = [];
    var _btTypesSources = {exchangeObjectTypes:'not_requested',registeredCatalogs:'not_requested'};
    var _btTypesCode = 'RegistryError';
    var _btTypesRecords;
    var _btTypesCount;
    var _btTypesRecord;
    var _btTypesForm;
    var _btTypesUrl;
    var _btTypesName;
    var _btTypesIndex;
    var _btTypesItem;
    var _btCatalogObjectType;
    try {
        if (_btTypesReq.kind != 'catalog') {
            _btTypesCount = ArrayCount(common.exchange_object_types);
            if (_btTypesCount > _btTypesMaxSource) {
                _btTypesCode = 'OutputLimit';
                throw 'The exchange object type registry exceeds 4096 entries';
            }
            _btTypesRecords = ArraySelectAll(common.exchange_object_types);
            for (_btTypesIndex = 0; _btTypesIndex < _btTypesCount; _btTypesIndex++) {
                _btTypesRecord = _btTypesRecords[_btTypesIndex];
                _btTypesName = String(_btTypesRecord.name.Value);
                if (_btTypesName == '') throw 'The exchange object type registry contains an unnamed entry';
                if (_btTypesReq.objectType != '' && _btTypesName != _btTypesReq.objectType) continue;
                _btTypesItems.push({kind:'object',name:_btTypesName,
                    isCustom:_btTypesRecord.is_custom.Value == true || StrBegins(_btTypesName, 'cc_'),
                    isHier:_btTypesRecord.is_hier.Value == true,
                    title:String(_btTypesRecord.title.Value),formUrl:String(_btTypesRecord.form_url.Value)});
            }
            _btTypesSources.exchangeObjectTypes = 'available';
        }
        if (_btTypesReq.kind != 'object') {
            _btTypesSources.registeredCatalogs = 'available';
            try {
                _btTypesRecords = DefaultDb.GetRegisteredCatalogs();
            } catch (_btTypesUnsupported) {
                if (!StrContains(String(_btTypesUnsupported), 'Unknown method: GetRegisteredCatalogs')) throw _btTypesUnsupported;
                _btTypesSources.registeredCatalogs = 'unavailable';
            }
            if (_btTypesSources.registeredCatalogs == 'available') {
                _btTypesCount = ArrayCount(_btTypesRecords);
                if (_btTypesCount > _btTypesMaxSource) {
                    _btTypesCode = 'OutputLimit';
                    throw 'The registered catalog registry exceeds 4096 entries';
                }
                for (_btTypesIndex = 0; _btTypesIndex < _btTypesCount; _btTypesIndex++) {
                    _btTypesUrl = _btTypesRecords[_btTypesIndex];
                    if (DataType(_btTypesUrl) != 'string' || _btTypesUrl == '') throw 'The registered catalog registry contains an invalid form URL';
                    _btTypesForm = FetchForm(_btTypesUrl);
                    _btTypesName = String(_btTypesForm.TopElem.Name);
                    if (_btTypesName == '') throw 'The registered catalog has no form root name';
                    _btCatalogObjectType = BtCatalogObjectName(_btTypesForm);
                    if (_btTypesReq.objectType != '' && _btCatalogObjectType != _btTypesReq.objectType) continue;
                    _btTypesItems.push({kind:'catalog',name:_btTypesName,isCustom:StrBegins(_btTypesName, 'cc_'),
                        isHier:_btTypesForm.IsHier,title:'',formUrl:_btTypesUrl,objectType:_btCatalogObjectType});
                }
            }
        }
        _btTypesCount = ArrayCount(_btTypesItems);
        if (_btTypesReq.offset < _btTypesCount) {
            // Descending kind puts objects first. Exact names and URLs break ties within each source.
            _btTypesItems = ArraySort(_btTypesItems, 'This.kind', '-', 'This.name', '+', 'This.formUrl', '+');
            for (_btTypesIndex = _btTypesReq.offset; _btTypesIndex < _btTypesCount && ArrayCount(_btTypesPage) < _btTypesReq.limit; _btTypesIndex++) {
                _btTypesRecord = _btTypesItems[_btTypesIndex];
                _btTypesItem = {kind:_btTypesRecord.kind,name:_btTypesRecord.name,isCustom:_btTypesRecord.isCustom};
                if (_btTypesRecord.title != '') _btTypesItem.title = _btTypesRecord.title;
                if (_btTypesRecord.formUrl != '') _btTypesItem.formUrl = _btTypesRecord.formUrl;
                // A positive exchange flag is informative. Its default false can hide catalog hierarchies.
                if (_btTypesRecord.kind == 'catalog' || _btTypesRecord.isHier) _btTypesItem.isHier = _btTypesRecord.isHier;
                if (_btTypesRecord.kind == 'catalog' && DataType(_btTypesRecord.objectType) == 'string')
                    _btTypesItem.objectType = _btTypesRecord.objectType == '' ? null : _btTypesRecord.objectType;
                if (_btTypesRecord.kind == 'object' && _btTypesRecord.formUrl != '') {
                    try {
                        _btTypesForm = FetchForm(_btTypesRecord.formUrl);
                        if (!_btTypesForm.IsCatalog && _btTypesForm.TopElem.Name == _btTypesRecord.name)
                            _btTypesItem.supportsCustomFields = _btTypesForm.TopElem.OptChild('custom_elems') != undefined;
                    } catch (_btTypesMetadataUnavailable) {
                        // The exchange entry is still available even if its form cannot be reflected.
                    }
                }
                _btTypesPage.push(_btTypesItem);
            }
        }
        var _btTypesJson = EncodeJson({ok:true,total:_btTypesCount,offset:_btTypesReq.offset,limit:_btTypesReq.limit,
            items:_btTypesPage,sources:_btTypesSources});
        if (StrLen(_btTypesJson) <= 262144) return _btTypesJson;
        _btTypesCode = 'OutputLimit';
        throw 'The object type page exceeds 256 KiB. Request a smaller page';
    } catch (_btTypesError) {
        var _btTypesMessage = String(_btTypesError);
        if (StrBegins(_btTypesMessage, 'OutputLimit:')) _btTypesCode = 'OutputLimit';
        if (StrCharCount(_btTypesMessage) > 2000) _btTypesMessage = StrLeftCharRange(_btTypesMessage, 2000);
        return EncodeJson({ok:false,error:{code:_btTypesCode,message:_btTypesMessage}});
    }
}

return EncodeJson(BtListObjectTypes(ParseJson('${request}')));
