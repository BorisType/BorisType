${projectionSource}
var _xqMaxRows = ${maxRows};
// Count only this materialized range, never the unbounded lazy source.
var _xqItems = ArraySelectAll(ArrayRange(XQuery(${queryLiteral}), 0, _xqMaxRows + 1));
var _xqRows = [];
var _xqChars = 0;
var _xqReason = null;
var _xqIndex;
var _xqRow;
var _xqSize;
for (_xqIndex = 0; _xqIndex < ArrayCount(_xqItems); _xqIndex++) {
    if (ArrayCount(_xqRows) >= _xqMaxRows) { _xqReason = 'rows'; break; }
    _xqRow = _btValueProject(_xqItems[_xqIndex], 0);
    _xqSize = StrCharCount(EncodeJson(_xqRow)) + 1;
    // At most four UTF-8 bytes per character, plus room for the envelope.
    // A complete row is projected before checking its size: no memory/work bound.
    if ((_xqChars + _xqSize) > 65000) { _xqReason = 'output'; break; }
    _xqRows.push(_xqRow);
    _xqChars = _xqChars + _xqSize;
}
var _xqTruncated = (_xqReason != null);
return { rows: _xqRows, returnedRows: ArrayCount(_xqRows), truncated: _xqTruncated, limitReason: _xqReason };
