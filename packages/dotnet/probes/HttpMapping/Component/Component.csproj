<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <AssemblyName>BorisType.ComponentMappingProbe.V$(Version)</AssemblyName>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BorisType.ApiVersion" Value="1" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Websoft.Commons" HintPath="$(WebsoftReferenceDir)/Websoft.Commons.dll" Private="false" />
    <Reference Include="Datex.log" HintPath="$(WebsoftReferenceDir)/Datex.log.dll" Private="false" />
    <Reference Include="Datex.XHTTP" HintPath="$(WebsoftReferenceDir)/Datex.XHTTP.dll" Private="false" />
  </ItemGroup>
</Project>
