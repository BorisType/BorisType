{
  "name": "boristype",
  "version": "1.0.0",
  "description": "TypeScript compilation tool for SPXML-Javascript (aka BorisScript) language",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.2"
  },
  "scripts": {
    "test": "node ./packages/botest/build/index.js tests/build",
    "test:semantic": "pnpm --filter @boristype/bt-ir test:semantic",
    "test:expressions": "pnpm --filter @boristype/bt-ir test:expressions",
    "test:expressions:baseline": "pnpm --filter @boristype/bt-ir test:expressions:baseline",
    "build:dotnet": "pnpm --filter @boristype/dotnet-workspace build:dotnet",
    "test:dotnet": "pnpm --filter @boristype/dotnet-workspace test:dotnet",
    "pack:dotnet": "pnpm --filter @boristype/dotnet-workspace pack:dotnet",
    "test:dotnet:pack": "pnpm --filter @boristype/dotnet-workspace test:dotnet:pack",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "version": "pnpm changeset version",
    "check-versions": "syncpack lint",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "lefthook install"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@boristype/eslint-plugin": "workspace:^",
    "@changesets/cli": "^3.0.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "2.2.1",
    "prettier": "^3.9.10",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.10",
    "typescript-eslint": "^8.72.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.44"
  }
}
