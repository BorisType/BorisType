{
  "name": "boristype",
  "version": "1.0.0",
  "description": "TypeScript compilation tool for SPXML-Javascript (aka BorisScript) language",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "test": "node ./packages/botest/build/index.js tests/build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "version": "pnpm changeset version",
    "check-versions": "syncpack lint",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,mjs,cjs,js}": [
      "prettier --write"
    ]
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@boristype/eslint-plugin": "workspace:^",
    "@changesets/cli": "^3.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.2",
    "typescript-eslint": "^8.70.1",
    "vitepress": "^1.6.4",
    "vue": "^3.5.43"
  }
}
